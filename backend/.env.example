# Firebase Admin SDK (valida o login corporativo nos endpoints da API)
# Gere em Firebase Console > Project settings > Service accounts > Generate new private key.
# O arquivo baixado nunca deve ser commitado (já coberto pelo .gitignore deste diretório).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Origens permitidas para CORS, separadas por vírgula (nunca "*" combinado com credenciais).
# Este servidor é o modo Docker/servidor opcional — o app desktop empacotado não o utiliza.
CORS_ALLOWED_ORIGINS=http://localhost:3118
