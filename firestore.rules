rules_version = '2';

// Deploy: firebase deploy --only firestore:rules --project reunia-5974f
//
// user_profiles/{email}: cadastro de quem pode usar o ReunIA e a chave do
// Groq de cada um. O ID do documento é o e-mail do usuário em minúsculas —
// não o Firebase uid — para o admin poder cadastrar sem precisar buscar o
// Object ID no Azure AD. Só o próprio usuário lê o próprio perfil
// (necessário no login, comparando com o claim "email" do custom token —
// ver functions/src/index.ts); ninguém escreve pelo cliente — cadastro é
// feito manualmente pelo admin direto no Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_profiles/{email} {
      allow read: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
