rules_version = '2';

// Deploy: firebase deploy --only firestore:rules --project reunia-5974f
//
// user_profiles/{email}: perfil de quem usa o ReuniAMB — acesso (authorized),
// função (role), chave do Groq e contadores de uso. O ID do documento é o
// e-mail do usuário em minúsculas — não o Firebase uid. Só o próprio usuário
// lê o próprio perfil (necessário no login, comparando com o claim "email"
// do custom token — ver functions/src/index.ts). Ninguém escreve pelo
// cliente: o perfil é criado automaticamente no primeiro login com
// @ambiental.sc (exchangeMicrosoftToken), os contadores são gravados por
// recordUsage e o admin gerencia tudo pelas Cloud Functions da aba Admin.
//
// A leitura exige sessão de custom token (o único login do app) e perfil com
// authorized == true: quem foi bloqueado não consegue mais ler o próprio
// perfil, que contém a chave do Groq. Documento inexistente também cai em
// permission-denied (resource é null), tratado como "sem acesso" no cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_profiles/{email} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email
        && resource != null
        && resource.data.authorized == true;
      allow write: if false;
    }
  }
}
